# ==============================================================================
# DataLens Studio — Environment Configuration Template
# Copy this file to .env and configure values appropriate for your environment.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB local or MongoDB Atlas)
# Local development default:
MONGODB_URI=mongodb://127.0.0.1:27017/datalens_studio
# Production / Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/datalens_studio?retryWrites=true&w=majority

# Session & Security Secrets
# Use a cryptographically strong 32+ character string in production
SESSION_SECRET=datalens_development_session_secret_change_in_production_32chars
SESSION_MAX_AGE_MS=86400000

# CORS & Frontend Origins (allow multiple separated by commas)
FRONTEND_ORIGIN=http://localhost:5000,http://127.0.0.1:5000

# File Upload Limits
MAX_FILE_SIZE_BYTES=5242880
MAX_ROW_COUNT=10000

# Rate Limiting
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
GENERAL_RATE_LIMIT_MAX=300
GENERAL_RATE_LIMIT_WINDOW_MS=900000
